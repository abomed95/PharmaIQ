# =============================================================================
# PharmaIQ — variables d'environnement
# Copier en `.env` (jamais committé) et remplir.
# =============================================================================

# --- Base de données (PostgreSQL / Supabase) --------------------------------
# URL pooling (runtime applicatif)
DATABASE_URL="postgresql://postgres:password@localhost:5432/pharmaiq?schema=public"
# URL directe (migrations Prisma, sans pooler)
DIRECT_URL="postgresql://postgres:password@localhost:5432/pharmaiq?schema=public"

# Rôle applicatif soumis à la RLS (créé par prisma/rls.sql).
# En production, DATABASE_URL doit utiliser ce rôle et NON le superutilisateur,
# sinon la Row-Level Security est contournée silencieusement.
APP_DB_ROLE="pharmaiq_app"

# --- Supabase (auth + storage) ----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
# Serveur uniquement — ne jamais exposer au client ni committer
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
# Bucket de stockage des photos de reçus
SUPABASE_RECEIPTS_BUCKET="receipts"

# --- Anthropic (IA) ----------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."
# Extraction de reçus (vision) — gros volume, rapport qualité/coût
ANTHROPIC_MODEL_VISION="claude-sonnet-5"
# Conseils d'achat + assistant conversationnel — raisonnement
ANTHROPIC_MODEL_TEXT="claude-opus-5"

# --- WhatsApp Business Cloud API (Meta) --------------------------------------
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v21.0"
# Nom du template approuvé par Meta pour le récapitulatif d'alertes
WHATSAPP_ALERT_TEMPLATE="pharmaiq_stock_digest"
# true = n'envoie rien, journalise seulement (dev)
WHATSAPP_DRY_RUN="true"

# --- Jobs planifiés ----------------------------------------------------------
# Protège POST /api/alerts/run (header `Authorization: Bearer $CRON_SECRET`)
CRON_SECRET="change-me"

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="fr"

# --- Facturation SaaS (phase 4) ---------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
