# PharmaIQ — paramètres du déploiement Google Cloud.
# Copier en config.env (ignoré par git) puis adapter. AUCUN SECRET ICI : les
# secrets sont saisis au clavier par setup.sh et stockés dans Secret Manager.

PROJECT_ID="ton-projet-gcp"
# Même région que le projet Supabase : c'est la latence application ↔ base qui compte.
REGION="europe-west1"

SERVICE="pharmaiq-web"           # service Cloud Run (identique à cloudbuild.yaml)
REPOSITORY="pharmaiq"            # dépôt Artifact Registry
SERVICE_ACCOUNT="pharmaiq-run"   # compte de service de l'application

# Valeurs PUBLIQUES, incrustées dans le JavaScript du navigateur au build.
# Les changer impose de reconstruire l'image.
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_ANON_KEY=""             # clé « anon » (publique), Supabase → Settings → API
# Vide : l'URL Cloud Run prévisible https://<SERVICE>-<numéro du projet>.<REGION>.run.app
# Renseigne-la si tu utilises un domaine (ex. https://app.exemple.dj).
APP_URL=""

# Identifiants de modèles Claude. Les valeurs par défaut du code (claude-sonnet-5,
# claude-opus-5) ne sont pas des identifiants valides : on les fixe ici.
ANTHROPIC_MODEL_VISION="claude-sonnet-5-5"   # lecture des reçus
ANTHROPIC_MODEL_TEXT="claude-opus-5-5"       # conseils d'achat et assistant

WHATSAPP_DRY_RUN="true"          # true : les messages WhatsApp sont journalisés, pas envoyés

MIN_INSTANCES="0"   # 0 : démarrage à froid d'environ 1 s ; 1 : toujours prêt (~10 $/mois)
MAX_INSTANCES="4"   # la limitation de débit est en mémoire : la limite réelle est multipliée par ce nombre

# Tâche d'alertes : chaque heure ; c'est alertConfig.sendHour (heure locale de la
# pharmacie) qui décide de l'envoi, pas cette planification.
ALERT_SCHEDULE="0 * * * *"
